  }

  message {
    uuid id PK
    uuid conversation_id FK
    uuid sender_id FK
    text type
    text content
    text url
    text file_name
    boolean is_read
    timestamptz created_at
  }

  notification {
    uuid id PK
    uuid user_id FK
    text type
    text title
    text body
    uuid reference_id
    text reference_type
    boolean is_read
    timestamptz created_at
  }

  bookmark {
    uuid id PK
    uuid user_id FK
    uuid listing_id FK
    timestamptz created_at
  }

  review {
    uuid id PK
    uuid listing_id FK
