  listings ||--o{ listing_image         : "has_legacy_images"
  listings ||--o{ listing_images        : "has_images"
  listings ||--o{ listing_amenity       : "tagged_with"
  amenity  ||--o{ listing_amenity       : "applies_to"

  listings ||--o{ application           : "receives"
