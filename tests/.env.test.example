# ViewXRent integration-test environment
#
# Copy this file to `.env.test` and fill in the values from the dedicated
# test Supabase project (NOT the dev/prod project — tests will create and
# delete rows).
#
# This file is the canonical source. The web Vitest suite reads its own
# `D:\school works\vxr-web\my-react-app\.env.test` (with VITE_ prefixes);
# keep both in sync. The seed script also writes a JSON twin
# (`tests/.env.test.json`) for Flutter `--dart-define-from-file`.

# --- Supabase test project ----------------------------------------------------
SUPABASE_URL=https://<test-project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role key — only the seed script uses this. NEVER ship to clients.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- PayMongo sandbox ---------------------------------------------------------
PAYMONGO_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Deterministic test users (created by seed.ts) ---------------------------
TEST_TENANT_A_EMAIL=tenant-a@vxr.test
TEST_TENANT_A_PASSWORD=VxrTest!Tenant-A-2026

TEST_TENANT_B_EMAIL=tenant-b@vxr.test
TEST_TENANT_B_PASSWORD=VxrTest!Tenant-B-2026

TEST_LANDLORD_EMAIL=landlord@vxr.test
TEST_LANDLORD_PASSWORD=VxrTest!Landlord-2026
